# Copy to the env file that automation/paths.yaml names (env_file:, in the webroot above
# this submodule) and fill in. Keep that file outside the webroot, so no static server or
# `wrangler deploy` can ever publish it.

# --- Where this file is (optional): VOICE_CHAT_ENV
# Only needed to use a different env file than the one automation/paths.yaml points at
# (env_file:, relative to the automation folder), or when there's no automation/paths.yaml.
# Set it in the shell, not in this file, since it says where to find this file:
#   VOICE_CHAT_ENV=/path/to/your.env node server/local-bridge.mjs
#   VOICE_CHAT_ENV=/path/to/your.env node server/push-secrets.mjs   (or pass the path as its first argument)
# VOICE_CHAT_ENV=/path/to/your.env

# --- Claude API key (required for Cloudflare; used locally only when LOCAL_BACKEND=api)
ANTHROPIC_API_KEY=sk-ant-...

# --- Model (both local and Cloudflare)
CLAUDE_MODEL=claude-opus-5-5

# --- Cloudflare: extra origins allowed to call /api/voice-chat (same origin is always allowed)
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- Local bridge (server/local-bridge.mjs)
# cli = Claude Code CLI with your logged-in Claude account; api = Claude API with the key above
LOCAL_BACKEND=cli
CLAUDE_CLI_PATH=claude
BRIDGE_PORT=3703
# The CLI ignores ANTHROPIC_API_KEY unless this is true (keeps local use on your subscription)
CLI_USE_API_KEY=false
# Optional headless CLI auth from `claude setup-token`, instead of an interactive login:
# CLAUDE_CODE_OAUTH_TOKEN=
# Extra non-localhost origins allowed to use the bridge (e.g. a LAN dev hostname):
# LOCAL_ALLOWED_ORIGINS=http://mybox.local:8080
# Bring This Tab Forward: on a Mac, the bridge brings the talking tab to the front when Claude answers while
# it's out of sight (POST /api/voice-chat/focus, through osascript). false turns it off:
# FOCUS=false

# --- Voices (shared/tts/; see "Voices" in README.md). Each is optional: without its key, a source is offered only
# to visitors with their own key from the Keys page. On the Worker, Deepgram Aura-2 needs no key (the AI binding).
# Push these to the Worker with: node server/push-secrets.mjs --voices
# XAI_API_KEY=            # Grok's voices ($15 per million characters)
# ELEVENLABS_API_KEY=     # ElevenLabs (free tier: 10,000 credits a month, non-commercial)
# ELEVENLABS_MODEL=eleven_flash_v2_5
# OPENAI_API_KEY=         # OpenAI's voices
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# GOOGLE_TTS_API_KEY=     # Google Cloud Text-to-Speech, Chirp 3 HD (a Cloud key with that API on, not a Gemini key)
# Kokoro on the bridge, once installed (npm install --prefix engine/server/kokoro). KOKORO=false leaves it out.
# KOKORO_DTYPE=q8
# KOKORO=false
