# Copy to .env and fill in. Best location: the folder ABOVE your webroot, so no static
# server or `wrangler deploy` can ever publish it. The bridge also finds it inside this
# submodule or the webroot, or wherever CLAUDE_VOICE_ENV points.

# --- Claude API key (required for Cloudflare; used locally only when LOCAL_BACKEND=api)
ANTHROPIC_API_KEY=sk-ant-...

# --- Model (both local and Cloudflare)
CLAUDE_MODEL=claude-opus-5-5

# --- Cloudflare: extra origins allowed to call /api/claude-voice (same origin is always allowed)
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- Local bridge (server/local-bridge.mjs)
# cli = Claude Code CLI with your logged-in Claude account; api = Claude API with the key above
LOCAL_BACKEND=cli
CLAUDE_CLI_PATH=claude
BRIDGE_PORT=8790
# The CLI ignores ANTHROPIC_API_KEY unless this is true (keeps local use on your subscription)
CLI_USE_API_KEY=false
# Optional headless CLI auth from `claude setup-token`, instead of an interactive login:
# CLAUDE_CODE_OAUTH_TOKEN=
# Extra non-localhost origins allowed to use the bridge (e.g. a LAN dev hostname):
# LOCAL_ALLOWED_ORIGINS=http://mybox.local:8080
